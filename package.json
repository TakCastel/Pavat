{
  "name": "pavat",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "ng serve",
    "build": "ng build",
    "preview": "ng serve --configuration=production",
    "build:mobile": "ng build && npx cap sync",
    "assets:mobile": "npx @capacitor/assets@3 generate --iconBackgroundColor '#202939' --iconBackgroundColorDark '#202939' --splashBackgroundColor '#202939' --splashBackgroundColorDark '#202939' --ios --android",
    "cap:init": "npx cap init",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:copy": "npx cap copy",
    "cap:run:ios": "npx cap run ios",
    "cap:run:android": "npx cap run android"
  },
  "dependencies": {
    "@angular/build": "~21.2.26",
    "@angular/cli": "~21.2.26",
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/compiler-cli": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/platform-browser": "~21.2.26",
    "@capacitor-community/admob": "^8.4.2",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@ng-icons/core": "^33.0.0",
    "@ng-icons/font-awesome": "^33.0.0",
    "@ng-icons/heroicons": "^33.0.0",
    "firebase": "^11.10.0",
    "html2canvas": "^1.4.1",
    "lucide-angular": "^0.562.0",
    "marked": "^17.0.1",
    "rxjs": "^7.8.2",
    "tailwindcss": "3.4.17"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "typescript": "~5.9.0",
    "vite": "^6.2.0"
  }
